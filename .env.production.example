APP_DOMAIN=lzezelj.com
SIGNAL_DOMAIN=signal.lzezelj.com
LIVEKIT_DOMAIN=livekit.lzezelj.com

POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://lc:replace-with-the-same-postgres-password@postgres:5432/lc

AUTH_URL=https://lzezelj.com
AUTH_TRUST_HOST=true
AUTH_SECRET=replace-with-a-long-random-value
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret
OWNER_EMAIL=you@example.com

NEXT_PUBLIC_SIGNALING_URL=wss://signal.lzezelj.com
SIGNALING_INTERNAL_URL=http://signaling:3001
SIGNALING_INTERNAL_SECRET=replace-with-another-long-random-value

LIVEKIT_URL=wss://livekit.lzezelj.com
LIVEKIT_INTERNAL_URL=http://host.docker.internal:7880
LIVEKIT_API_KEY=replace-with-a-random-api-key
LIVEKIT_API_SECRET=replace-with-a-long-random-value
