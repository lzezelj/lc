DATABASE_URL=postgresql://lc:change-me@localhost:5432/lc
AUTH_SECRET=replace-with-a-long-random-value
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret
OWNER_EMAIL=you@example.com
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:3001
SIGNALING_INTERNAL_URL=http://localhost:3001
SIGNALING_INTERNAL_SECRET=replace-with-another-long-random-value

# Local LiveKit development server from compose.yaml only.
# Replace all three values for production and use a wss:// URL.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
